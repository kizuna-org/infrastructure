version: "3.9"

services:
  ocserv:
    image: "{{ ocserv_docker_image }}"
    container_name: ocserv
    restart: unless-stopped
    network_mode: host
    cap_add:
      - NET_ADMIN
    environment:
{% for key, value in ocserv_docker_env.items() %}
      {{ key }}: "{{ value }}"
{% endfor %}
      TZ: "{{ ocserv_timezone }}"
    volumes:
      - "{{ ocserv_config_dir }}/ocserv.conf:/etc/ocserv/ocserv.conf:ro"
      - "{{ ocserv_config_dir }}/ocpasswd:/etc/ocserv/ocpasswd:ro"
      - "{{ ocserv_tls_cert_src }}:/etc/ocserv/server-cert.pem:ro"
      - "{{ ocserv_tls_key_src }}:/etc/ocserv/server-key.pem:ro"
{% for volume in ocserv_compose_extra_volumes %}
      - "{{ volume }}"
{% endfor %}

